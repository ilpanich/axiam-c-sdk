#=============================================================================
# Target rules for target examples/CMakeFiles/management_manifest.dir

# All Build rule for target.
examples/CMakeFiles/management_manifest.dir/all: CMakeFiles/axiam.dir/all
	$(MAKE) $(MAKESILENT) -f examples/CMakeFiles/management_manifest.dir/build.make examples/CMakeFiles/management_manifest.dir/depend
	$(MAKE) $(MAKESILENT) -f examples/CMakeFiles/management_manifest.dir/build.make examples/CMakeFiles/management_manifest.dir/build
	@$(CMAKE_COMMAND) -E cmake_echo_color "--switch=$(COLOR)" --progress-dir=/home/user/axiam-c-sdk/build-asan/CMakeFiles --progress-num=28 "Built target management_manifest"
.PHONY : examples/CMakeFiles/management_manifest.dir/all

# Build rule for subdir invocation for target.
examples/CMakeFiles/management_manifest.dir/rule: cmake_check_build_system
	$(CMAKE_COMMAND) -E cmake_progress_start /home/user/axiam-c-sdk/build-asan/CMakeFiles 18
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 examples/CMakeFiles/management_manifest.dir/all
	$(CMAKE_COMMAND) -E cmake_progress_start /home/user/axiam-c-sdk/build-asan/CMakeFiles 0
.PHONY : examples/CMakeFiles/management_manifest.dir/rule

# Convenience name for target.
management_manifest: examples/CMakeFiles/management_manifest.dir/rule
.PHONY : management_manifest

# clean rule for target.
examples/CMakeFiles/management_manifest.dir/clean:
	$(MAKE) $(MAKESILENT) -f examples/CMakeFiles/management_manifest.dir/build.make examples/CMakeFiles/management_manifest.dir/clean
.PHONY : examples/CMakeFiles/management_manifest.dir/clean

#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	$(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

